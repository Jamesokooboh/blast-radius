.work/
.plugin-cache/
.terraform/
tfplan
*.tfplan
terraform.tfstate
terraform.tfstate.backup
__pycache__/

# Regenerable in seconds via ./plan.sh --all; ~250KB each. Summaries and diffs
# are committed instead, since those are the readable evidence.
results/plans/*.plan.json

# The competition brief is micro1's material, not ours to redistribute, and the
# blanket rule also stops a stray PDF being committed by accident.
#
# The written deliverables stay as markdown: GitHub renders them better than a
# PDF does, and a committed PDF is a snapshot that drifts silently when the
# markdown changes. Rebuild them with tools/md_to_pdf.py if a submission form
# ever wants files rather than a repository link.
#
# The recording pack is the exception -- it is read away from the machine while
# recording, and has no markdown equivalent in use.
*.pdf
!report/video-recording-pack.pdf
