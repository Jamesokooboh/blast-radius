.work/
.plugin-cache/
.terraform/
tfplan
*.tfplan
terraform.tfstate
terraform.tfstate.backup
__pycache__/

# Regenerable in seconds via ./plan.sh --all; ~250KB each. Summaries and diffs
# are committed instead, since those are the readable evidence.
results/plans/*.plan.json

# The competition brief is micro1's material, not ours to redistribute. The
# blanket rule stays so no stray PDF is committed by accident; our own four are
# negated below and are committed on purpose, so judges get them without running
# anything. Regenerate them with tools/md_to_pdf.py and tools/make_video_pdf.py.
*.pdf
!README.pdf
!REPRODUCE.pdf
!report/changelog.pdf
!report/video-recording-pack.pdf
