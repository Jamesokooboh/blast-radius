+
+# Browser uploads land here, are validated by the worker, then moved to the
+# data bucket. Anything still here after a day is a failed upload.
+resource "aws_s3_bucket" "tmp_uploads" {
+  bucket = "${var.name_prefix}-tmp-uploads"
+
+  tags = {
+    Name      = "${var.name_prefix}-tmp-uploads"
+    Retention = "24h"
+  }
+}
+
+resource "aws_s3_bucket_lifecycle_configuration" "tmp_uploads" {
+  bucket = aws_s3_bucket.tmp_uploads.id
+
+  rule {
+    id     = "expire"
+    status = "Enabled"
+
+    filter {}
+
+    expiration {
+      days = 1
+    }
+  }
+}
